# ============================================================
# La Parrilla de Sore — Variables de entorno
# Copia este archivo como .env.local y llena los valores reales
# NUNCA hagas commit de .env.local
# ============================================================

# --- MongoDB Atlas (solo servidor, nunca NEXT_PUBLIC_) ---
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="parrilla_sore_dev"

# --- Better Auth ---
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-largo"
BETTER_AUTH_URL="http://localhost:3000"

# --- URL pública de la app (no es un secreto) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Vercel Blob (agregar cuando se conecte el almacén de imágenes) ---
# BLOB_READ_WRITE_TOKEN=""

# --- Cron job secret (secreto aleatorio para proteger el endpoint) ---
# CRON_SECRET=""

# --- Sentry (opcional, agregar tras MVP) ---
# SENTRY_AUTH_TOKEN=""
# NEXT_PUBLIC_SENTRY_DSN=""

# --- Entorno ---
NODE_ENV="development"
